#!/usr/bin/env python3
"""Repository-local launcher for modelc."""

from __future__ import annotations

import os
from pathlib import Path
import sys


TOOLS_DIRECTORY = Path(__file__).resolve().parent.parent
TOOLS_VENV = TOOLS_DIRECTORY / ".venv"
TOOLS_PYTHON = TOOLS_VENV / "bin" / "python"

if TOOLS_PYTHON.is_file() and Path(sys.prefix) != TOOLS_VENV:
    os.execv(
        str(TOOLS_PYTHON),
        [str(TOOLS_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
    )

sys.path.insert(0, str(TOOLS_DIRECTORY / "src"))

from modelc.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
