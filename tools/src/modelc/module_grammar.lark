start: module_item*

?module_item: spec_declaration
            | use_declaration
            | predicate_declaration
            | type_declaration
            | object_declaration
            | external_declaration

spec_declaration: "spec" IDENTIFIER ";"
use_declaration: "use" use_path ";"
use_path: IDENTIFIER ("::" IDENTIFIER)*

predicate_declaration: "predicate" IDENTIFIER generic_parameters? "(" parameters? ")" "->" type_expression predicate_tail
generic_parameters: "<" IDENTIFIER ("," IDENTIFIER)* ">"
parameters: parameter ("," parameter)* ","?
parameter: IDENTIFIER ":" type_expression
?predicate_tail: ";" | predicate_body
predicate_body: "{" expression_statement* "}"

type_declaration: "type" IDENTIFIER type_tail
?type_tail: ";" | "{" field_declaration* "}"
field_declaration: IDENTIFIER ":" type_expression ";"

object_declaration: "object" IDENTIFIER ":" type_expression "{" object_item* "}"
?object_item: initial_state_property
            | parent_property
            | source_property
            | attrs_declaration
            | state_declaration
            | reference_declaration
initial_state_property: "initial_state" ":" expression ";"
parent_property: "parent" ":" expression ";"
source_property: "source" ":" expression ";"
attrs_declaration: "attrs" "{" field_declaration* "}"
reference_declaration: "reference" IDENTIFIER "{" reference_assignment* "}"
reference_assignment: assignable_expression "=" expression ";"

external_declaration: "external" IDENTIFIER "{" external_item* "}"
?external_item: drives_block | emits_block

state_declaration: "state" qualified_identifier "{" state_item* "}"
?state_item: invariant_block | transitions_block | actions_block
invariant_block: "invariant" expression_block
transitions_block: "transitions" "{" transition_handler* "}"
actions_block: "actions" "{" action_handler* "}"

transition_handler: "on" expression "->" expression "{" handler_item* "}"
action_handler: "on" expression "{" handler_item* "}"
?handler_item: depends_on_block
             | may_change_block
             | drives_block
             | ensures_block
             | emits_block
             | deferred_declaration
depends_on_block: "depends_on" expression_block
may_change_block: "may_change" expression_block
drives_block: "drives" expression_block
ensures_block: "ensures" expression_block
emits_block: "emits" expression_block
expression_block: "{" expression_statement* "}"

deferred_declaration: "deferred" IDENTIFIER "." DECIMAL_INTEGER "{" deferred_item* "}"
?deferred_item: category_property
              | summary_property
              | evidence_block
              | close_when_property
category_property: "category" ":" expression ";"
summary_property: "summary" ":" STRING ";"
evidence_block: "evidence" expression_block
close_when_property: "close_when" ":" STRING ";"

type_expression: qualified_identifier type_arguments?
type_arguments: "<" type_expression ("," type_expression)* ">"
qualified_identifier: IDENTIFIER ("::" IDENTIFIER)*

expression_statement: expression ";"
?expression: disjunction
?disjunction: conjunction ("||" conjunction)*
?conjunction: comparison ("&&" comparison)*
?comparison: sum (COMPARISON_OPERATOR sum)?
?sum: product (ADD_OPERATOR product)*
?product: unary (MULTIPLY_OPERATOR unary)*
?unary: UNARY_OPERATOR unary | postfix_expression
?postfix_expression: primary postfix_operation*
?primary: IDENTIFIER | DECIMAL_INTEGER | STRING | "(" expression ")"
?postfix_operation: "." IDENTIFIER
                  | "::" IDENTIFIER
                  | "[" expression "]"
                  | "(" arguments? ")"
arguments: expression ("," expression)* ","?
assignable_expression: IDENTIFIER assignable_operation*
?assignable_operation: "." IDENTIFIER | "::" IDENTIFIER | "[" expression "]"

COMPARISON_OPERATOR: "==" | "!=" | ">=" | "<=" | ">" | "<"
ADD_OPERATOR: "+" | "-"
MULTIPLY_OPERATOR: "*" | "/" | "%"
UNARY_OPERATOR: "!" | "-"
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
DECIMAL_INTEGER: /[0-9]+/
STRING: /"([^"\\\r\n]|\\.)*"/
LINE_COMMENT: /\/\/[^\r\n]*/
BLOCK_COMMENT: /\/\*(?s:.*?)\*\//

%import common.WS
%ignore WS
%ignore LINE_COMMENT
%ignore BLOCK_COMMENT
