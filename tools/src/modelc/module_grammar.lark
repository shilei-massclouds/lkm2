start: module_item*

?module_item: spec_declaration
            | use_declaration
            | predicate_declaration
            | type_declaration
            | object_declaration
            | external_declaration

spec_declaration: "spec" IDENTIFIER ";"
use_declaration: "use" use_path ";"
use_path: IDENTIFIER ("::" IDENTIFIER)*

predicate_declaration: "predicate" IDENTIFIER generic_parameters? "(" parameters? ")" "->" type_expression predicate_tail
generic_parameters: "<" IDENTIFIER ("," IDENTIFIER)* ">"
parameters: parameter ("," parameter)* ","?
parameter: IDENTIFIER ":" type_expression
?predicate_tail: ";" | predicate_body
predicate_body: "{" expression_statement* "}"

type_declaration: "type" IDENTIFIER type_base? type_tail
type_base: ":" type_expression
?type_tail: ";" | "{" type_item* "}"
?type_item: field_declaration
          | continuation_property
          | sched_core_property
          | initial_state_property
          | state_declaration
field_declaration: mutable_marker? IDENTIFIER ":" type_expression field_default? ";"
mutable_marker: "mutable"
field_default: "=" expression

object_declaration: "object" IDENTIFIER ":" type_expression "{" object_item* "}"
?object_item: initial_state_property
            | field_declaration
            | continuation_property
            | parent_property
            | source_property
            | idle_task_property
            | attrs_declaration
            | state_declaration
            | reference_declaration
initial_state_property: "initial_state" ":" expression ";"
continuation_property: "continuation" ":" IDENTIFIER ";"
sched_core_property: "sched_core" ":" IDENTIFIER ";"
parent_property: "parent" ":" expression ";"
source_property: "source" ":" expression ";"
idle_task_property: "idle_task" ":" expression ";"
attrs_declaration: "attrs" "{" field_declaration* "}"
reference_declaration: "reference" IDENTIFIER "{" reference_assignment* "}"
reference_assignment: assignable_expression "=" expression ";"

external_declaration: "external" IDENTIFIER "{" external_item* "}"
?external_item: drives_block | emits_block | resumes_statement

state_declaration: "state" qualified_identifier "{" state_item* "}"
?state_item: invariant_block | transitions_block | actions_block
invariant_block: "invariant" expression_block
transitions_block: "transitions" "{" transition_handler* "}"
actions_block: "actions" "{" action_handler* "}"

transition_handler: override_marker? "on" handler_signal transition_handler_tail
?transition_handler_tail: "->" expression handler_body -> concrete_transition_handler
                        | ";"                         -> abstract_transition_handler
action_handler: override_marker? "on" handler_signal action_handler_tail
?action_handler_tail: handler_body -> concrete_action_handler
                    | ";"          -> abstract_action_handler
override_marker: "override"
handler_signal: qualified_identifier "(" parameters? ")" | qualified_identifier
handler_body: "{" handler_item* "}"
?handler_item: depends_on_block
             | may_change_block
             | drives_block
             | yields_statement
             | print_statement
             | panic_statement
             | ensures_block
             | establishes_block
             | emits_block
             | resumes_statement
             | selects_statement
             | updates_block
             | deferred_declaration
depends_on_block: "depends_on" expression_block
may_change_block: "may_change" expression_block
drives_block: "drives" signal_body
yields_statement: "yields" expression ";"
resumes_statement: "resumes" expression ";"
selects_statement: "selects" IDENTIFIER ";"
print_statement: "print" STRING ";"
panic_statement: "panic" STRING ";"
ensures_block: "ensures" expression_block
establishes_block: "establishes" expression_block
emits_block: "emits" signal_body
?signal_body: expression_block | expression ";" -> single_signal_body
updates_block: "updates" "{" update_statement* "}"
update_statement: assignable_expression "=" expression ";"
expression_block: "{" expression_statement* "}"

deferred_declaration: "deferred" IDENTIFIER "." DECIMAL_INTEGER "{" deferred_item* "}"
?deferred_item: category_property
              | summary_property
              | evidence_block
              | close_when_property
category_property: "category" ":" expression ";"
summary_property: "summary" ":" STRING ";"
evidence_block: "evidence" expression_block
close_when_property: "close_when" ":" STRING ";"

type_expression: qualified_identifier type_arguments?
type_arguments: "<" type_expression ("," type_expression)* ">"
qualified_identifier: IDENTIFIER ("::" IDENTIFIER)*

expression_statement: expression ";"
?expression: disjunction
?disjunction: conjunction (OR_OPERATOR conjunction)*
?conjunction: comparison (AND_OPERATOR comparison)*
?comparison: sum (COMPARISON_OPERATOR sum)?
?sum: product (ADD_OPERATOR product)*
?product: unary (MULTIPLY_OPERATOR unary)*
?unary: UNARY_OPERATOR unary | postfix_expression
?postfix_expression: primary postfix_operation*
?primary: IDENTIFIER | DECIMAL_INTEGER | STRING | "(" expression ")"
postfix_operation: "." IDENTIFIER       -> member_operation
                 | "::" IDENTIFIER      -> path_operation
                 | "[" expression "]"   -> index_operation
                 | "(" arguments? ")"  -> call_operation
arguments: expression ("," expression)* ","?
assignable_expression: IDENTIFIER assignable_operation*
assignable_operation: "." IDENTIFIER       -> member_operation
                    | "::" IDENTIFIER      -> path_operation
                    | "[" expression "]"   -> index_operation

COMPARISON_OPERATOR: "==" | "!=" | ">=" | "<=" | ">" | "<"
ADD_OPERATOR: "+" | "-"
MULTIPLY_OPERATOR: "*" | "/" | "%"
UNARY_OPERATOR: "!" | "-"
OR_OPERATOR: "||"
AND_OPERATOR: "&&"
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
DECIMAL_INTEGER: /[0-9]+/
STRING: /"([^"\\\r\n]|\\.)*"/
LINE_COMMENT: /\/\/[^\r\n]*/
BLOCK_COMMENT: /\/\*(?s:.*?)\*\//

%import common.WS
%ignore WS
%ignore LINE_COMMENT
%ignore BLOCK_COMMENT
